
{
  "rules": {
    ".read": true,
    ".write": true,
    "users": {
      "$userId": {
        ".read": true,
        ".write": true,
        ".validate": "newData.hasChildren(['email', 'userId'])"
      }
    },
    "tasks": {
      "$taskId": {
        ".read": true,
        ".write": true,
        ".validate": "newData.hasChildren(['userId', 'status'])"
      }
    },
    "withdrawals": {
      "$withdrawalId": {
        ".read": true,
        ".write": true,
        ".validate": "newData.hasChildren(['userId', 'amount', 'status'])"
      }
    },
    "adminTasks": {
      "$taskId": {
        ".read": true,
        ".write": true
      }
    },
    "pwaInstalls": {
      "$installId": {
        ".read": true,
        ".write": true
      }
    }
  }
}
